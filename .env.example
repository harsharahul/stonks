# Stonks Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
# Nothing in this file is a real credential — placeholders only.

# ── Database (bare-metal local dev uses localhost; docker-compose overrides) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stonks
POSTGRES_PASSWORD=stonks_password_change_me
POSTGRES_DB=stonks

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8080
API_KEY=dev_local_key_change_me
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=120

# ── LLM (AI Trading Desk, stock knowledge, analytics) ────────────────────────
# Provider: none | openai | ollama
ANALYTICS_LLM_PROVIDER=ollama
OPENAI_API_KEY=
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b
# docker-compose only: point containers at a remote Ollama server
# (falls back to the optional local `ollama` compose profile container)
OLLAMA_DOCKER_HOST=
OLLAMA_DOCKER_MODEL=qwen3:14b

# ── Market data providers (optional — ingestion skips gracefully if missing) ─
POLYGON_API_KEY=
ALPHA_VANTAGE_API_KEY=

# ── OIDC / Authentik (user identity — public PKCE client, no client secret) ──
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=
# Comma-separated emails that receive the admin role on first login
ADMIN_EMAILS=
# Frontend build args (docker-compose / CI): same values as the two above
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=

# ── Brokerage (per-user Alpaca trading) ──────────────────────────────────────
# Fernet key encrypting user broker credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_CREDS_ENCRYPTION_KEY=
# Global kill switch: true rejects ALL order placement across all users
BROKER_TRADING_HALTED=false
